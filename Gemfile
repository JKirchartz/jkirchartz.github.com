source 'https://rubygems.org'
ruby '3.2.3'

git_source(:github) { |repo_name| "https://github.com/#{repo_name}" }

gem 'jekyll', '~> 4.3'

group :jekyll_plugins do
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-paginate'
  gem 'jekyll-seo-tag'
  gem 'jemoji'
  gem 'jekyll-gist'
  gem 'jekyll-github-metadata'
  gem 'jekyll-compose'
end

gem 'ffi'

# Ruby 3+ removed these from stdlib; Jekyll's local server needs them
gem 'webrick'
gem 'csv'
gem 'logger'
gem 'base64'
